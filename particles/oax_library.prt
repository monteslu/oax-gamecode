// weather (loop; for func_oax_emitter, placed by `oacontent weather`): a column
// of falling streaks. Particles do not collide with the world: the emitters
// sit over exposed ground only.
particle oax/rain {
	{
		count				1800
		material			oaxfx/spark
		time				0.9
		bunching			1
		distribution		cylinder 560 560 40
		direction			cone 3
		orientation			aimed 0 0.025
		speed				"-1000" to "-900"
		size				"2.2" to "1.6"
		gravity				0
		fadeIn				0.05
		fadeOut				0.1
		color				0.5 0.6 0.75 0.7
		fadeColor			0.5 0.6 0.75 0.7
		softDistance		-1
	}
}

particle oax/snow {
	{
		count				1200
		material			oaxfx/smoke
		time				7
		bunching			1
		distribution		cylinder 560 560 40
		direction			cone 12
		speed				"-60" to "-35"
		size				"1.8" to "1.2"
		rotation			"0"
		gravity				world 0
		fadeIn				0.03
		fadeOut				0.05
		color				0.95 0.97 1 0.8
		fadeColor			0.95 0.97 1 0.8
		softDistance		-1
		lit					1
	}
}

