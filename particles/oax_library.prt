}

// a ring of light racing out along the surface
particle oax/shockwave {
	{
		count				1
		material			oaxfx/ripple
		time				0.38
		cycles				1
		bunching			0
		distribution		sphere 0 0 0
		direction			cone 0
		orientation			z
		speed				"0"
		size				"12" to "170"
		rotation			"0"
		gravity				0
		fadeIn				0
		fadeOut				0.9
		color				1 0.8 0.5 0.65
		fadeColor			1 0.5 0.2 0
		softDistance		-1
	}
}

// fire: flames, embers and a smoke tail (loop; for func_oax_emitter)
