// oax_library.prt: the effect library (Phase 2 of the content enhancement
// plan): per-material impacts, the big explosion pieces, and fire.
// Syntax as oax_weapons.prt. One-shot systems are spawned by cg_oax_fx.c;
// the flame decls loop and belong to func_oax_emitter entities.

// bullets on metal: more, whiter, faster sparks
particle oax/metal_sparks {
	{
		count				16
		material			oaxfx/spark
		time				0.35
		cycles				1
		bunching			0
		distribution		sphere 1 1 1
		direction			cone 70
		orientation			aimed 0 0.04
		speed				"380" to "90"
		size				"1" to "0.4"
		gravity				world 420
		fadeIn				0
		fadeOut				0.5
		color				0.9 0.95 1 1
		fadeColor			0 0 0 0
		softDistance		-1
	}
}

// bullets on stone, brick, earth: a small puff of dust, a few chips
particle oax/dust_puff {
	{
		count				4
		material			oaxfx/smoke
		time				0.9
		cycles				1
		bunching			0.3
		distribution		sphere 2 2 2
		direction			cone 55
		speed				"40" to "8"
		size				"6" to "22"
		rotation			"20" to "40"
		gravity				world -8
		fadeIn				0.05
		fadeOut				0.7
		color				0.62 0.56 0.47 0.7
		fadeColor			0.62 0.56 0.47 0
		lit					1
	}
	{
		count				5
		material			oaxfx/smoke
		time				0.6
		cycles				1
		bunching			0
		distribution		sphere 1 1 1
		direction			cone 80
		speed				"220" to "70"
		size				"1.6" to "1"
		rotation			"0"
		gravity				world 500
		fadeIn				0
		fadeOut				0.6
		color				0.35 0.3 0.25 0.9
		fadeColor			0.35 0.3 0.25 0
		lit					1
	}
}

// the hot core of a big explosion
particle oax/fireball {
	{
		count				7
