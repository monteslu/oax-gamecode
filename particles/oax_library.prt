		fadeOut				0.6
		color				0.14 0.13 0.12 0.45
		fadeColor			0.14 0.13 0.12 0
		lit					1
	}
	{
		count				6
		material			oaxfx/haze
		time				1.6
		bunching			1
		distribution		cylinder 6 6 2
		direction			cone 8
		speed				"60" to "30"
		size				"24" to "56"
