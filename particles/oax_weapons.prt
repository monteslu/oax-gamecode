particle oax/rail_impact {
	{
		count				16
		material			oaxfx/spark
		time				0.45
		cycles				1
		bunching			0
		distribution		sphere 2 2 2
		direction			cone 80
		orientation			aimed 0 0.04
		speed				"280" to "60"
		size				"1.2" to "0.5"
		gravity				world 300
		entityColor			1
		fadeIn				0
		fadeOut				0.5
		color				1 1 1 1
		fadeColor			0 0 0 0
		softDistance		-1
	}
	{
		count				6
		material			oaxfx/glow
		time				0.35
		cycles				1
		bunching			0
		distribution		sphere 2 2 2
